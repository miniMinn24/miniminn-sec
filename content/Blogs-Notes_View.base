filters:
  and:
    - file.ext == "md"
formulas:
  "": ""
  sort_date: |
    file.ctime.format("YYYYMMDD")
views:
  - type: cards
    name: 🪶 Blogs
    filters:
      and:
        - category.contains("blog")
    order:
      - file.name
      - tags
      - category
      - author
      - date
    sort:
      - property: formula.sort_date
        direction: DESC
    cardSize: 300
    imageAspectRatio: 0.3
    image: note.banner
  - type: cards
    name: 📓 Playbook
    filters:
      and:
        - category.contains("playbook")
    order:
      - file.name
      - tags
      - category
      - author
      - date
    sort:
      - property: formula.sort_date
        direction: DESC
    cardSize: 300
    imageAspectRatio: 0.3
    image: note.banner
  - type: cards
    name: 🎓 Course Walkthroughs
    filters:
      and:
        - category.contains("note")
    order:
      - file.name
      - tags
      - category
      - author
      - date
    sort:
      - property: formula.sort_date
        direction: DESC
    cardSize: 300
    image: note.banner
    imageAspectRatio: 0.3
